"""
This is a one time cleanup, not something meant to run more than once.
It exists because the live Sheet was already populated before this
naming convention and this specific duplicate were noticed, so the fix
has to reach the real backend directly rather than only living in
seed.json, which only helps a brand new install.
"""

import json
import sys
import urllib.request

if len(sys.argv) < 2:
    print("Usage: python fix_airey_and_rename.py <apps-script-web-app-url> [seed.json]")
    sys.exit(1)

WEB_APP_URL = sys.argv[1]
SEED_FILE = sys.argv[2] if len(sys.argv) > 2 else "seed.json"

MERGE_FROM_ID = "NOCODE_m86"
MERGE_TO_ID = "A213"
MERGE_NAME = "Lexi Airey"


def post(action, payload):
    body = json.dumps({"action": action, "payload": payload}).encode("utf-8")
    request = urllib.request.Request(
        WEB_APP_URL,
        data=body,
        headers={"Content-Type": "text/plain;charset=utf-8"},
        method="POST",
    )
    with urllib.request.urlopen(request) as response:
        return json.loads(response.read())


def to_first_last(name):
    if "," not in name:
        return name
    last, first = name.split(",", 1)
    return f"{first.strip()} {last.strip()}"


with open(SEED_FILE, encoding="utf-8") as f:
    seed_data = json.load(f)

# seed.json already has the corrected names and the merge applied
# locally (for future fresh installs), which makes this safe to run more
# than once by accident, renaming an already correctly named member to
# the same name is a harmless no-op, and merging an already merged
# member simply fails with "both members must exist", not silently
# corrupt anything.
renames = [
    {"id": m["id"], "name": to_first_last(m["name"])}
    for m in seed_data["members"]
    if m["id"] != MERGE_TO_ID
]

print("Merging Airey duplicate...")
print(post("mergeMember", {
    "fromId": MERGE_FROM_ID,
    "toId": MERGE_TO_ID,
    "name": MERGE_NAME,
    "active": True,
}))

print("Renaming all other members to First Last format...")
print(post("bulkRenameMembers", renames))

print("Done.")